COMPOSE_PROJECT_NAME=dvb-booking
POSTGRES_IMAGE=postgres:18-bookworm
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:stable-alpine
NODE_IMAGE=node:24-bookworm-slim
DVB_RELEASE=local
# Written by scripts/preflight-ports.py --write
DVB_HTTP_PORT=18473
DB_NAME=dvb_booking
DB_USER=dvb_app
DB_SUPERUSER=dvb_admin
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
# Indexing is closed unless the operator explicitly opens it for the approved HTTPS origin.
SEO_INDEXING_ALLOWED=false
SEO_APPROVED_CANONICAL_ORIGIN=
