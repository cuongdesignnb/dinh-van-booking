NODE_ENV=production
APP_ENV=development
APP_DATA_MODE=database
ALLOW_DEMO_DATA=false
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dvb_booking
DB_USER=dvb_app
DB_PASSWORD_FILE=/run/secrets/db_app_password
REDIS_URL=redis://redis:6379
API_PORT=3001
PUBLIC_ORIGINS=http://localhost:18473,http://127.0.0.1:18473
MEDIA_ROOT=/var/lib/dvb/media
MEDIA_PUBLIC_BASE=/media
MEDIA_MAX_BYTES=10485760
SESSION_SECRET_FILE=/run/secrets/session_secret
SESSION_IDLE_MINUTES=60
SESSION_TTL_MINUTES=720
GUEST_SESSION_TTL_MINUTES=1440
QUOTE_TTL_MINUTES=30
HOLD_TTL_MINUTES=20
